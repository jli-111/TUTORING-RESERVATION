# Reference only. Export in your shell; .env is not automatically loaded.
MYSQL_DATABASE=studyroom
MYSQL_USER=studyroom
MYSQL_PASSWORD=choose-a-local-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
FRONTEND_URL=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173
DJANGO_DEBUG=1
# Real deployment requires a random DJANGO_SECRET_KEY, DEBUG=0, HTTPS,
# real allowed hosts and SMTP. See docs/SETUP.md.
